# raven 会话签名密钥。**必填**，至少 16 字符；换掉它会让所有已登录会话失效。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=mzk0Cd03w5PsBgUto551_R8Xm_vzCdJMlVxu3KtzE1BzTPtKoXgqUKXYlDMOXNFH

# 配置来源。不设的话按这个顺序找：
#   <RAVEN_DATA_DIR>/raven.config.json → <repo>/config/raven.config.json → ...local.json
# RAVEN_CONFIG=/absolute/path/to/raven.config.json

# 用户数据目录：raven.db 与 services.json 落在这里（容器里是数据卷）。
# RAVEN_DATA_DIR=/data

# SQLite 文件（验证脚本靠它指向临时路径）。
# RAVEN_DB_FILE=/data/raven.db

# 时区。脚本进程会继承它，TZ 不对会让日志时间与人的直觉差 8 小时。
TZ=Asia/Shanghai

# ---- Agent（可选）---------------------------------------------------------
# 不设这两项时 /agent 页面仍能打开，但会显示「Agent Runtime 不可用」。
#
# ⚠️ AGENT_RUNTIME_TOKEN 是 Agent 的全部权限凭据，**只在服务端**。
# 浏览器只跟 raven 说话，由 raven 带这个 token 转发 —— 前端从不接触它。
AGENT_RUNTIME_URL=http://127.0.0.1:5900
AGENT_RUNTIME_TOKEN=0aNkTI5G8yTC7ulBg061_k0AG_j5QQn6RLPsmm-_APlzxkwFGGtorqkJuyHdvi6d

# 构建期注入的版本号（Dockerfile 的 ARG RAVEN_VERSION）。本地是 dev。
# RAVEN_VERSION=abc1234
