# 宿主数据根目录,挂载 ${DATA_DIR}/dsh 和 ${DATA_DIR}/workspace 到容器
# 相对路径以 docker-compose.yml 所在目录为基准;留空或删除本行则默认 ./data
DATA_DIR=./data

# 局域网暴露:宿主监听地址与端口(只给本机用把 BIND_IP 改成 127.0.0.1)
BIND_IP=0.0.0.0
HOST_PORT=3080

# 鉴权壳登录凭据
# AUTH_PASSWORD 留空则首次启动生成随机密码,写入 ${DATA_DIR}/dsh/auth-password 并打到容器日志
AUTH_USER=workbench
AUTH_PASSWORD=
# 会话签名密钥,留空则自动生成并持久化到 ${DATA_DIR}/dsh/auth-secret
AUTH_SECRET=

# dsh 对外地址与额外信任的 Host(改成你的局域网 IP/域名,日志里的访问链接才正确)
# DSH_PUBLIC_URL=http://192.168.1.10:3080/
# DSH_TRUSTED_HOST=192.168.1.10:3080
