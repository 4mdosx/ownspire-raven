# Copy to /srv/ownspire/compose/raven.env and chmod 600.
# Do not commit the copy that contains real secrets.
# RAVEN_TAG is not read by the container. ownspire.mjs passes it to Compose.

# 会话签名密钥。**必填**，至少 16 字符；换掉它会让所有已登录会话失效 —— 那正是它的用途。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# 配置与数据都在挂载的数据卷里；Dockerfile 已经默认这两个值，这里写出来是为了让
# 「配置在哪」这件事在人看 compose 时就清楚，而不是要翻 Dockerfile。
RAVEN_DATA_DIR=/data
RAVEN_CONFIG=/data/raven/raven.config.json

TZ=Asia/Shanghai

# 允许调用 Server Action 的来源（raven 用 REST 为主，留着与其他服务保持一致）。
SERVER_ACTION_ALLOWED_ORIGINS=raven.example.ts.net
